{
  "agent": {
    "Nexus": {
      "description": "主编排器。负责分诊、委派、分支管理、todo 跟踪、计划维护、归档协调与最终交付。",
      "mode": "primary",
      "model": "copilot/gpt-4o",
      "permission": {
        "bash": {
          "": "ask"
        },
        "write": {
          ".Nexus/**": "allow",
          "AGENTS.md": "allow",
          "CLAUDE.md": "allow"
        },
        "edit": {
          ".Nexus/**": "allow",
          "AGENTS.md": "allow",
          "CLAUDE.md": "allow"
        }
      }
    },
    "Generalist": {
      "description": "通用高质量多面手 agent。根据已确认方案直接编写代码，负责非 UI 功能实现。",
      "mode": "subagent",
      "model": "oaicopilot/mimo-v2.5-pro",
      "permission": {
        "bash": {
          "": "ask"
        },
        "write": {
          ".Nexus/**": "allow",
          "**/*.ts": "allow",
          "**/*.js": "allow",
          "**/*.tsx": "allow",
          "**/*.jsx": "allow",
          "**/*.py": "allow",
          "**/*.go": "allow",
          "**/*.rs": "allow",
          "**/*.java": "allow",
          "**/*.c": "allow",
          "**/*.cpp": "allow",
          "**/*.h": "allow",
          "**/*.hpp": "allow",
          "**/*.css": "allow",
          "**/*.scss": "allow",
          "**/*.less": "allow",
          "**/*.html": "allow",
          "**/*.vue": "allow",
          "**/*.svelte": "allow"
        },
        "edit": {
          ".Nexus/**": "allow",
          "**/*.ts": "allow",
          "**/*.js": "allow",
          "**/*.tsx": "allow",
          "**/*.jsx": "allow",
          "**/*.py": "allow",
          "**/*.go": "allow",
          "**/*.rs": "allow",
          "**/*.java": "allow",
          "**/*.c": "allow",
          "**/*.cpp": "allow",
          "**/*.h": "allow",
          "**/*.hpp": "allow",
          "**/*.css": "allow",
          "**/*.scss": "allow",
          "**/*.less": "allow",
          "**/*.html": "allow",
          "**/*.vue": "allow",
          "**/*.svelte": "allow"
        }
      }
    },
    "Investigator": {
      "description": "研究者。负责研究当前情况，产出架构级方案、功能级预研方案、功能级方案步骤。",
      "mode": "subagent",
      "model": "oaicopilot/mimo-v2.5-pro",
      "permission": {
        "bash": {
          "": "ask"
        },
        "write": {
          ".Nexus/1-research/**": "allow",
          ".Nexus/2-Scheme/**": "allow",
          ".Nexus/.tool/**": "allow"
        },
        "edit": {
          ".Nexus/1-research/**": "allow",
          ".Nexus/2-Scheme/**": "allow",
          ".Nexus/.tool/**": "allow"
        }
      }
    },
    "Reviewer": {
      "description": "独立评审者。负责根据实现情况文档审查真实代码，可新增或修改自动化测试。",
      "mode": "subagent",
      "model": "oaicopilot/mimo-v2.5-pro",
      "permission": {
        "bash": {
          "": "ask"
        },
        "write": {
          ".Nexus/3-implement/.old/**": "allow",
          ".Nexus/4-review/**": "allow",
          ".Nexus/4-review/.old/**": "allow",
          "**/*.test.*": "allow",
          "**/*.spec.*": "allow",
          "**/__tests__/**": "allow"
        },
        "edit": {
          ".Nexus/3-implement/.old/**": "allow",
          ".Nexus/4-review/**": "allow",
          ".Nexus/4-review/.old/**": "allow",
          "**/*.test.*": "allow",
          "**/*.spec.*": "allow",
          "**/__tests__/**": "allow"
        }
      }
    },
    "DocWriter": {
      "description": "文档编写与管理者。负责用户确认方案落盘、研究文档归档、doc/ 与 README.md 更新。",
      "mode": "subagent",
      "model": "oaicopilot/mimo-v2.5",
      "permission": {
        "bash": {
          "": "ask"
        },
        "write": {
          ".Nexus/1-research/.old/**": "allow",
          ".Nexus/2-Scheme/**": "allow",
          "CHANGELOG.md": "allow",
          "doc/**": "allow",
          "README.md": "allow"
        },
        "edit": {
          ".Nexus/1-research/.old/**": "allow",
          ".Nexus/2-Scheme/**": "allow",
          "CHANGELOG.md": "allow",
          "doc/**": "allow",
          "README.md": "allow"
        }
      }
    },
    "UI_Investigator": {
      "description": "UI/视觉层专项研究者。负责 UI 功能研究、界面设计方案、布局结构、状态覆盖。",
      "mode": "subagent",
      "model": "copilot/gpt-4o",
      "permission": {
        "bash": {
          "": "ask"
        },
        "write": {
          ".Nexus/1-research/**": "allow",
          ".Nexus/.tool/**": "allow"
        },
        "edit": {
          ".Nexus/1-research/**": "allow",
          ".Nexus/.tool/**": "allow"
        }
      }
    },
    "UI_Coder": {
      "description": "高品质 UI 呈现层实现者。负责布局、样式、视觉层次、响应式、交互反馈与无障碍呈现。",
      "mode": "subagent",
      "model": "oaicopilot/mimo-v2.5",
      "permission": {
        "bash": {
          "": "ask"
        },
        "write": {
          ".Nexus/**": "allow",
          "**/*.css": "allow",
          "**/*.scss": "allow",
          "**/*.less": "allow",
          "**/*.html": "allow",
          "**/*.vue": "allow",
          "**/*.svelte": "allow",
          "**/*.tsx": "allow",
          "**/*.jsx": "allow"
        },
        "edit": {
          ".Nexus/**": "allow",
          "**/*.css": "allow",
          "**/*.scss": "allow",
          "**/*.less": "allow",
          "**/*.html": "allow",
          "**/*.vue": "allow",
          "**/*.svelte": "allow",
          "**/*.tsx": "allow",
          "**/*.jsx": "allow"
        }
      }
    },
    "WebSearcher": {
      "description": "唯一的 Web 搜索与信息检索专家。系统中所有网络搜索都必须通过此 agent 执行。",
      "mode": "subagent",
      "model": "oaicopilot/mimo-v2.5",
      "permission": {
        "bash": {
          "": "ask"
        },
        "write": {
          ".Nexus/.search-cache/**": "allow",
          ".Nexus/.tool/**": "allow"
        },
        "edit": {
          ".Nexus/.search-cache/**": "allow",
          ".Nexus/.tool/**": "allow"
        }
      }
    }
  }
}
